<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net6.0-windows;net8.0-windows</TargetFrameworks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <RootNamespace>TS4SimRipper</RootNamespace>
    <AssemblyName>TS4SimRipper</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <SelfContained>false</SelfContained>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <ManifestKeyFile>TS4SimRipper_TemporaryKey.pfx</ManifestKeyFile>
    <ManifestCertificateThumbprint>60C09E8E8648A004C24288ED7DF459FE973C025C</ManifestCertificateThumbprint>
    <Version>3.14.2.11</Version>
    <Version_>$(Version.Replace(".","_"))</Version_>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>$(Version)</ApplicationVersion>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <DefineConstants>$(DefineConstants);NETCORE</DefineConstants>
    <Copyright>Copyright ©  2019</Copyright>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="*.grannyrig">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="*.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="*.package">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="*.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="protobuf-net" Version="3.2.30" />
    <PackageReference Include="Ookii.Dialogs.Wpf" Version="5.0.1" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="DDSPanel">
      <HintPath>..\..\..\CmarNYC_TS4SimRipper_3_14_2_11\DDSPanel.dll</HintPath>
    </Reference>
    <Reference Include="s4pi.ImageResource">
      <HintPath>..\..\..\CmarNYC_TS4SimRipper_3_14_2_11\s4pi.ImageResource.dll</HintPath>
    </Reference>
    <Reference Include="s4pi.Interfaces">
      <HintPath>..\..\..\CmarNYC_TS4SimRipper_3_14_2_11\s4pi.Interfaces.dll</HintPath>
    </Reference>
    <Reference Include="s4pi.Package">
      <HintPath>..\..\..\CmarNYC_TS4SimRipper_3_14_2_11\s4pi.Package.dll</HintPath>
    </Reference>
    <Reference Include="s4pi.Settings">
      <HintPath>..\..\..\CmarNYC_TS4SimRipper_3_14_2_11\s4pi.Settings.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="ZipOutputPath" AfterTargets="Publish">
    <ZipDirectory SourceDirectory="$(PublishDir)" Overwrite="true" DestinationFile="$(MSBuildProjectDirectory)\..\release\CmarNYC_TS4SimRipper_$(Version_).zip" />
  </Target>
</Project>